{
  "name": "dsh-fold-context",
  "version": "0.1.0",
  "description": "Replayable numbered context release and official DSH summarization, with optional memory adapters",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" }, "./memory": { "types": "./lib/memory/contracts.d.ts", "default": "./lib/memory/contracts.js" }, "./package.json": "./package.json" },
  "files": ["lib", "README.md", "docs", "examples"],
  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "pnpm run build && node --test test/*.test.mjs" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.2", "zod": "^4.4.3" },
  "devDependencies": { "@deepseek-ai/dsh-invariants": "0.2.0-rc.2", "@types/node": "^22.18.0", "typescript": "^5.9.3" },
  "engines": { "node": ">=24.11.0" },
  "license": "MIT"
}
